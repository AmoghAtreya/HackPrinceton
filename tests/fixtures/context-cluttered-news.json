    {"role": "AXLink", "label": "Email", "url": "file:///Users/demo/triage/demo/sites/cluttered-news.html#", "frame": {"x": 446, "y": 312, "width": 51, "height": 18}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 2, 2]},
    {"role": "AXLink", "label": "Print", "url": "file:///Users/demo/triage/demo/sites/cluttered-news.html#", "frame": {"x": 507, "y": 312, "width": 51, "height": 18}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 2, 3]},
    {"role": "AXLink", "label": "Copy link", "url": "file:///Users/demo/triage/demo/sites/cluttered-news.html#", "frame": {"x": 568, "y": 312, "width": 79, "height": 18}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 2, 4]},
    {"role": "AXStaticText", "label": "", "value": "Medicare's annual open enrollment period runs from October 15 to December 7. During this window, beneficiaries can switch between Original Medicare and Medicare Advantage, or change their Part D prescription drug plan, with new coverage starting January 1.", "frame": {"x": 240, "y": 344, "width": 840, "height": 66}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 3, 0]},
    {"role": "AXStaticText", "label": "", "value": "ADVERTISEMENT — Compare 2027 plans with our partner", "frame": {"x": 240, "y": 426, "width": 420, "height": 16}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 4, 0]},
    {"role": "AXButton", "label": "Get Quotes", "frame": {"x": 670, "y": 423, "width": 90, "height": 22}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 4, 1]},
    {"role": "AXStaticText", "label": "", "value": "For 2027, the out-of-pocket cap on covered prescription drugs under Part D continues to apply, which means that once your spending on covered drugs reaches the annual limit, you pay nothing more for covered drugs for the rest of the calendar year. However, premiums, deductibles and formularies — the list of drugs a plan covers — can change every year.", "frame": {"x": 240, "y": 466, "width": 840, "height": 88}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 5, 0]},
    {"role": "AXStaticText", "label": "", "value": "Experts recommend reviewing your plan's Annual Notice of Change, which plans must mail by September 30. Check whether your current medications remain on the formulary, whether their tier placement has changed, and whether your preferred pharmacy is still in-network. A drug moving to a higher tier can significantly raise your copay or coinsurance.", "frame": {"x": 240, "y": 570, "width": 840, "height": 88}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 6, 0]},
    {"role": "AXHeading", "label": "How to compare plans", "value": "2", "frame": {"x": 240, "y": 674, "width": 840, "height": 32}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 7]},
    {"role": "AXStaticText", "label": "", "value": "The official Medicare Plan Finder lets you enter your prescriptions and pharmacies to compare total estimated annual costs, not just premiums. State Health Insurance Assistance Programs (SHIP) offer free, unbiased one-on-one counseling. Be cautious of unsolicited calls claiming to be from Medicare; Medicare will not call you to sell a plan or ask for your Medicare number.", "frame": {"x": 240, "y": 718, "width": 840, "height": 88}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 8, 0]},
    {"role": "AXHeading", "label": "Key dates", "value": "2", "frame": {"x": 240, "y": 822, "width": 840, "height": 32}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 9]},
    {"role": "AXStaticText", "label": "", "value": "Open enrollment ends December 7. If you are in a Medicare Advantage plan, a separate Medicare Advantage Open Enrollment Period runs from January 1 to March 31, during which you can switch to another Advantage plan or return to Original Medicare once.", "frame": {"x": 240, "y": 866, "width": 840, "height": 66}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 10, 0]},
    {"role": "AXLink", "label": "Compare plans on Medicare.gov", "url": "https://www.medicare.gov/plan-compare/", "frame": {"x": 240, "y": 948, "width": 220, "height": 20}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 11, 0]},
    {"role": "AXLink", "label": "Find free SHIP counseling", "url": "https://www.shiphelp.org/", "frame": {"x": 480, "y": 948, "width": 190, "height": 20}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 11, 2]},

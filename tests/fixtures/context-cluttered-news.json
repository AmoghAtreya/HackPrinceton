    {"role": "AXHeading", "label": "Medicare Open Enrollment 2027: What Changes For Your Part D Plan", "value": "1", "frame": {"x": 240, "y": 210, "width": 840, "height": 72}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 0]},
    {"role": "AXStaticText", "label": "", "value": "By Staff Writer · Updated Nov 14, 2026 · 6 min read", "frame": {"x": 240, "y": 288, "width": 400, "height": 16}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 1, 0]},
    {"role": "AXLink", "label": "Share on Facebook", "url": "file:///Users/demo/triage/demo/sites/cluttered-news.html#", "frame": {"x": 240, "y": 312, "width": 135, "height": 18}, "secure": false, "enabled": true, "depth": 2, "path": [0, 1, 0, 2, 1, 2, 0]},

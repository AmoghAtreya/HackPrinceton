{
  "name": "triage",
  "productName": "Triage",
  "version": "0.1.0",
  "private": true,
  "description": "A small companion for your Mac desktop.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "phishing:build": "node scripts/build-link-scanner.mjs",
    "speech:build": "node scripts/build-speech-helper.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "browser:install": "playwright install chromium",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types --test tests/browser/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@aws-sdk/client-polly": "3.1169.0",
    "@aws-sdk/client-transcribe-streaming": "3.1169.0",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "electron": "^45.2.3",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
